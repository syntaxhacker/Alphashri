# Trading Configuration
PAPER_TRADING_ENABLED=true
MARKET=in
TRADING_START_TIME=09:20
TRADING_END_TIME=15:30

# Telegram Configuration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_ENABLED=false

# Upstox API Configuration (for live trading - use with caution)
UPSTOX_CLIENT_ID=your_upstox_client_id
UPSTOX_CLIENT_SECRET=your_upstox_client_secret
UPSTOX_REDIRECT_URI=your_redirect_uri
UPSTOX_ACCESS_TOKEN=your_access_token

# Risk Management Overrides (Optional)
STOP_LOSS_PCT=-0.5
TAKE_PROFIT_PCT=0.4
MAX_DAILY_ENTRIES=2
POSITION_SIZE=20000

# Trading Mode Selection
# Options: intraday_breakouts, volume_spike_monitor, price_move_alerts, 
#          smart_fomo_detector, overbought_short_signals, heavy_breakout
TRADING_MODE=volume_spike_monitor

# Log Level
LOG_LEVEL=INFO

# Deployment Environment
ENVIRONMENT=production
PORT=8080

# Railway Specific
RAILWAY_STATIC_URL=
RAILWAY_PUBLIC_DOMAIN=