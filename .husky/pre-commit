#!/usr/bin/env sh

# Skip for merge commits
if git rev-parse -q --verify MERGE_HEAD > /dev/null 2>&1; then
  echo "Merge commit detected, skipping pre-commit checks."
  exit 0
fi

echo "Running pre-commit checks..."

# Run Python unit tests
echo "Running Python unit tests..."
cd stock-screener-ui
uv run --python 3.11 pytest -m unit -q --tb=short
if [ $? -ne 0 ]; then
  echo "❌ Python unit tests failed! Commit aborted."
  exit 1
fi
echo "✅ Python unit tests passed."

cd stock-screener-ui

# Get staged files (only .ts, .tsx, .js, .jsx, .css)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|css)$' | head -50)

if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to lint/format."
else
  # Check size limits on staged files
  echo "Checking file size limits..."
  STAGED_JS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$')
  if [ ! -z "$STAGED_JS_FILES" ]; then
    echo "$STAGED_JS_FILES" | xargs node check-size-limits.cjs
    if [ $? -ne 0 ]; then
      echo "❌ Size limits exceeded! Commit aborted."
      exit 1
    fi
  fi

  # Remove console.log statements from staged files
  echo "Removing console.log statements..."
  if [ ! -z "$STAGED_JS_FILES" ]; then
    echo "$STAGED_JS_FILES" | xargs node remove-console-logs.js
    # Re-stage modified files
    echo "$STAGED_JS_FILES" | xargs git add --
  fi

  # Run lint check on staged files only
  echo "Running oxlint on staged files..."
  echo "$STAGED_FILES" | xargs bun run lint --
  LINT_EXIT_CODE=$?

  if [ $LINT_EXIT_CODE -ne 0 ]; then
    echo "Linting failed! Commit aborted."
    exit 1
  fi

  # Auto-format staged files only
  echo "Running oxfmt on staged files..."
  echo "$STAGED_FILES" | xargs bun run format --

  # Re-stage formatted files
  echo "$STAGED_FILES" | xargs git add --
fi

# Load nvm if available
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
nvm use 20 2>/dev/null || true

# Check if dev server is running, start it if not
DEV_PID=""
if ! curl -s http://localhost:5173 > /dev/null 2>&1; then
  echo "Starting dev server..."
  bun run dev > /tmp/dev_server.log 2>&1 &
  DEV_PID=$!
  sleep 5
fi

# Run the tests (using mocked API responses)
echo "Running Playwright tests..."
bun run test

# Capture exit code
TEST_EXIT_CODE=$?

# Kill dev server if we started it
if [ ! -z "$DEV_PID" ]; then
  kill $DEV_PID 2>/dev/null
fi

if [ $TEST_EXIT_CODE -ne 0 ]; then
  echo "Tests failed! Commit aborted."
  exit 1
fi

echo "All checks passed!"
exit 0
