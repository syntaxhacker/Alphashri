#!/usr/bin/env sh

if git rev-parse -q --verify MERGE_HEAD > /dev/null 2>&1; then
  echo "Merge commit detected, skipping pre-commit checks."
  exit 0
fi

echo "Running pre-commit checks..."

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$')
if [ ! -z "$STAGED_PY" ]; then
  echo "Running Python unit tests..."
  cd stock-screener-ui
  # Use the venv's pytest directly (nautilus_trader installed there)
  .venv/bin/pytest -m unit -q --tb=short
  PY_EXIT=$?
  if [ $PY_EXIT -ne 0 ]; then
    echo "❌ Python unit tests failed! Commit aborted."
    exit 1
  fi
  echo "✅ Python unit tests passed."
  cd ..
else
  echo "No Python files staged, skipping Python tests."
fi

STAGED_PY_MODELS=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'stock-screener-ui/db/models/.*\.py$')
if [ ! -z "$STAGED_PY_MODELS" ]; then
  echo "Regenerating schema docs..."
  cd stock-screener-ui
  .venv/bin/python scripts/generate_schema_docs.py
  git add docs/schema.md
  echo "✅ Schema docs updated."
  cd ..
fi

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|css)$' | head -50)

if [ -z "$STAGED_FILES" ]; then
  echo "No staged JS/TS files to lint/format."
else
  cd stock-screener-ui

  STAGED_REL=$(echo "$STAGED_FILES" | sed 's|^stock-screener-ui/||')

  STAGED_JS_FILES=$(echo "$STAGED_REL" | grep -E '\.(ts|tsx|js|jsx)$')
  if [ ! -z "$STAGED_JS_FILES" ]; then
    echo "Checking file size limits..."
    echo "$STAGED_JS_FILES" | xargs node check-size-limits.cjs
    if [ $? -ne 0 ]; then
      echo "❌ Size limits exceeded! Commit aborted."
      exit 1
    fi

    echo "Removing console.log statements..."
    echo "$STAGED_JS_FILES" | xargs node remove-console-logs.js
    echo "$STAGED_JS_FILES" | xargs git add --
  fi

  echo "Running oxlint on staged files..."
  echo "$STAGED_REL" | xargs bun run lint --
  if [ $? -ne 0 ]; then
    echo "Linting failed! Commit aborted."
    exit 1
  fi

  echo "Running oxfmt on staged files..."
  echo "$STAGED_REL" | xargs bun run format --
  echo "$STAGED_REL" | xargs git add --

  cd ..
fi

cd stock-screener-ui
echo "Running frontend unit tests..."
bun run test
if [ $? -ne 0 ]; then
  echo "❌ Frontend unit tests failed! Commit aborted."
  exit 1
fi
echo "✅ Frontend unit tests passed."
cd ..

echo "All checks passed!"
exit 0
