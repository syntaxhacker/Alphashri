{
  "name": "alphashri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check_bundle_interop.mjs",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=alphashri",
    "deploy:preview": "wrangler pages deploy dist --project-name=alphashri --branch=preview",
    "test": "vitest run --dir src",
    "test:unit": "vitest run --dir src",
    "test:fast": "vitest run --dir src --changed",
    "test:coverage": "vitest run --dir src --coverage",
    "test:coverage:ui": "vitest run src/ui --coverage --coverage.include='src/ui/**' --coverage.exclude='src/**/*.test.{ts,tsx}' --coverage.thresholds.lines=85 --coverage.thresholds.functions=70 --coverage.thresholds.branches=65 --coverage.thresholds.statements=75",
    "test:coverage:report": "vitest run --dir src --coverage --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "test:e2e": "playwright test tests/e2e",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests",
    "typecheck": "node node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit --pretty false",
    "typecheck:ratchet": "node node_modules/typescript7/bin/tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "typecheck:ts5": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint:types": "oxlint -c .oxlintrc.types.json --type-aware src",
    "contrast": "bun run scripts/check_contrast.ts",
    "prepare": "husky",
    "check:duplicates": "jscpd src tests --min-lines 5 --reporters console",
    "check:unused": "knip",
    "check:deps": "depcheck",
    "check:all": "bun run lint && bun run check:duplicates && bun run check:duplicates:python && bun run check:unused",
    "check:duplicates:python": "bash scripts/check_duplicates_python.sh",
    "check:bundle": "node scripts/check_bundle_interop.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit:components": "node scripts/component_audit.mjs",
    "audit:evidence": "node scripts/evidence-audit.mjs",
    "audit:evidence:pending": "node scripts/evidence-audit.mjs --allow-missing",
    "evidence:app": "SCREENSHOT_EVIDENCE=1 playwright test tests/e2e/design-evidence.spec.ts -c playwright.evidence.config.ts",
    "evidence:screener": "SCREENSHOT_EVIDENCE=1 playwright test tests/e2e/screener-evidence.spec.ts -c playwright.evidence.config.ts",
    "evidence:patterns": "SCREENSHOT_EVIDENCE=1 playwright test tests/e2e/patterns-evidence.spec.ts -c playwright.evidence.config.ts",
    "evidence:all": "SCREENSHOT_EVIDENCE=1 playwright test tests/e2e/design-evidence.spec.ts tests/e2e/screener-evidence.spec.ts tests/e2e/patterns-evidence.spec.ts -c playwright.evidence.config.ts && echo 'Captures complete — gate with: bun run audit:evidence'",
    "evidence:benchmark": "node scripts/evidence/benchmark.mjs",
    "evidence:manifest": "node scripts/evidence/write-manifest.mjs",
    "test:e2e:changed": "playwright test --only-changed=origin/develop tests/e2e",
    "test:e2e:failed": "playwright test --last-failed tests/e2e",
    "audit:typography": "node scripts/typography-audit.mjs",
    "audit:typography:check": "node scripts/typography-audit.mjs --check",
    "visual:test": "node scripts/visual-regression.mjs",
    "visual:update": "UPDATE_SNAPSHOTS=1 node scripts/visual-regression.mjs",
    "perf:chart:fixtures": "python scripts/perf/gen_chart_fixtures.py",
    "perf:chart:matrix": "node scripts/perf/chart_tf_matrix.mjs",
    "perf:chart": "node scripts/perf/chart_perf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sentry/vite-plugin": "^5.1.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/html-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.9",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "4.1.0",
    "depcheck": "^1.4.7",
    "dukascopy-node": "^1.50.0",
    "happy-dom": "^20.8.8",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "knip": "^6.47.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "playwright": "^1.58.2",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "typescript": "^5.7.3",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^4.0.18",
    "wrangler": "^4.73.0"
  },
  "dependencies": {
    "@sentry/solid": "^11.12.0",
    "@solidjs/router": "^1.0.3",
    "@solidjs/testing-library": "^0.8.10",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "lightweight-charts": "^5.2.1",
    "lz-string": "^1.5.0",
    "solid-js": "^1.9.20",
    "solid-notifications": "^1.2.0"
  }
}
