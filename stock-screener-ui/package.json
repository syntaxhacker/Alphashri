{
  "name": "alphashri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=alphashri",
    "deploy:preview": "wrangler pages deploy dist --project-name=alphashri --branch=preview",
    "test": "vitest run --dir src",
    "test:unit": "vitest run --dir src",
    "test:e2e": "playwright test tests/e2e",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests",
    "prepare": "husky",
    "check:duplicates": "jscpd src tests --min-lines 5 --reporters console",
    "check:unused": "knip",
    "check:deps": "depcheck",
    "check:all": "bun run lint && bun run check:duplicates && bun run check:duplicates:python && bun run check:unused",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:duplicates:python": "jscpd api/ scripts/ trading/ backtest/ db/ -f python --min-lines 5 --reporters console"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@playwright/test": "^1.58.2",
    "@sentry/vite-plugin": "^5.1.1",
    "@storybook/addon-a11y": "^10.2.16",
    "@storybook/addon-docs": "^10.2.16",
    "@storybook/addon-onboarding": "^10.2.16",
    "@storybook/addon-vitest": "^10.2.16",
    "@storybook/react-vite": "^10.2.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "^4.0.18",
    "depcheck": "^1.4.7",
    "happy-dom": "^20.8.8",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "jsdom": "^29.0.1",
    "knip": "^5.85.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "playwright": "^1.58.2",
    "storybook": "^10.2.16",
    "typescript": "^5.7.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.73.0"
  },
  "dependencies": {
    "@mantine/core": "^8.3.16",
    "@mantine/dates": "^8.3.16",
    "@mantine/hooks": "^8.3.16",
    "@mantine/notifications": "^8.3.16",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/react": "^10.43.0",
    "@storybook/react": "^10.2.16",
    "@tabler/icons-react": "^3.38.0",
    "@tanstack/react-table": "^8.21.3",
    "d3-interpolate": "^3.0.1",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "lz-string": "^1.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1"
  }
}
