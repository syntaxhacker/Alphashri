{
  "name": "alphashri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=alphashri",
    "deploy:preview": "wrangler pages deploy dist --project-name=alphashri --branch=preview",
    "test": "vitest run --dir src",
    "test:unit": "vitest run --dir src",
    "test:e2e": "playwright test tests/e2e",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests",
    "prepare": "husky",
    "check:duplicates": "jscpd src tests --min-lines 5 --reporters console",
    "check:unused": "knip",
    "check:deps": "depcheck",
    "check:all": "bun run lint && bun run check:duplicates && bun run check:duplicates:python && bun run check:unused",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:duplicates:python": "jscpd api/ scripts/ trading/ backtest/ db/ -f python --min-lines 5 --reporters console --threshold 10 || echo 'DRY note: threshold exceeded (migrations/strategy boilerplate intentional - see docs/DRY_OPPORTUNITIES.md); treated as non-fatal for this check.'"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@playwright/test": "^1.58.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@sentry/vite-plugin": "^5.1.1",
    "@storybook/addon-a11y": "^10.2.16",
    "@storybook/addon-docs": "^10.2.16",
    "@storybook/addon-onboarding": "^10.2.16",
    "@storybook/addon-vitest": "^10.2.16",
    "@storybook/react-vite": "^10.2.16",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-solid": "^1.9.19",
    "depcheck": "^1.4.7",
    "happy-dom": "^20.8.8",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "jsdom": "^29.0.1",
    "knip": "^5.85.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "playwright": "^1.58.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.2.16",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.3",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^4.0.18",
    "wrangler": "^4.73.0"
  },
  "dependencies": {
    "@pipsend/charts": "^2.0.1",
    "@sentry/solid": "^11.12.0",
    "@solidjs/router": "^1.0.3",
    "@solidjs/testing-library": "^0.8.10",
    "@storybook/react": "^10.2.16",
    "@tabler/icons-react": "^3.38.0",
    "@tanstack/solid-table": "^9.3.1",
    "d3-interpolate": "^3.0.1",
    "dayjs": "^1.11.20",
    "dukascopy-node": "^1.50.0",
    "echarts": "^6.0.0",
    "lightweight-charts": "^5.2.1",
    "lz-string": "^1.5.0",
    "marked": "^18.2.0",
    "remark-gfm": "^4.0.1",
    "solid-js": "^1.9.19",
    "solid-notifications": "^1.2.0"
  }
}
