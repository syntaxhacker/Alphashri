# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8765

# -----------------------------------------------------------------------------
# Frontend -> Backend URLs (Vite exposes these as VITE_*)
# Use http://localhost:8765 for local dev, production URL for prod
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8765
VITE_WS_BASE_URL=ws://localhost:8765

# -----------------------------------------------------------------------------
# Backend Configuration (prefixed BACKEND_ to avoid Vite exposure)
# -----------------------------------------------------------------------------
BACKEND_JWT_SECRET=alphashri-dev-secret-key-2024
BACKEND_LOG_LEVEL=DEBUG
BACKEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database
# Use SQLite for local dev (default), PostgreSQL for production
# -----------------------------------------------------------------------------
# SQLite (default - uncomment)
DATABASE_URL=sqlite:///./db/alphashri.db

# PostgreSQL (production - uncomment and update)
# DATABASE_URL=postgresql://user:password@host:5432/database

# -----------------------------------------------------------------------------
# External APIs (optional)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-...
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
