# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8765

# -----------------------------------------------------------------------------
# Frontend -> Backend URLs (Vite exposes these as VITE_*)
# Use http://localhost:8765 for local dev, production URL for prod
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8765
VITE_WS_BASE_URL=ws://localhost:8765

# -----------------------------------------------------------------------------
# Backend Configuration (prefixed BACKEND_ to avoid Vite exposure)
# -----------------------------------------------------------------------------
BACKEND_JWT_SECRET=alphashri-dev-secret-key-2024
BACKEND_LOG_LEVEL=DEBUG
BACKEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database
# Use SQLite for local dev (default), PostgreSQL for production
# -----------------------------------------------------------------------------
# SQLite (default - uncomment)
DATABASE_URL=sqlite:///./db/alphashri.db

# PostgreSQL (production - uncomment and update)
# DATABASE_URL=postgresql://user:password@host:5432/database

# -----------------------------------------------------------------------------
# External APIs (optional)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-...
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=

# -----------------------------------------------------------------------------
# TradingView scanner auth (optional)
# Without cookies the scanner is 15 minutes delayed. With a logged-in session
# it returns update_mode=streaming (real-time).
# Local dev: leave blank — cookies are read from the local Chrome profile.
# Production: paste the cookie header from a logged-in browser, e.g.
#   TRADINGVIEW_COOKIES=sessionid=...; sessionid_sign=...
# or JSON: {"sessionid": "...", "sessionid_sign": "..."}
# -----------------------------------------------------------------------------
TRADINGVIEW_COOKIES=
TV_COOKIE_TTL_SEC=600

# -----------------------------------------------------------------------------
# Redis Cache (optional — app works without it, just no caching)
# Use redis://localhost:6379/0 for local dev
# Use rediss://... for Upstash / Redis Cloud in production
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Telegram Notifications (optional — set to enable trade alerts)
# Create a bot via @BotFather, get the token, then get your chat_id
# from @userinfobot or by messaging your bot and checking getUpdates API
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
