{
  "schema_version": 1,
  "description": "API latency budgets (milliseconds). warm = p95 after warmups; cold = p95 of a single request in a fresh process. null means no agreed budget for that mode (reported as INFO, never enforced).",
  "defaults": {
    "warmups": 5,
    "iterations": 30,
    "warn_factor": 1.25,
    "percentiles": [50, 95, 99]
  },
  "routes": {
    "health": {
      "method": "GET",
      "path": "/api/health",
      "query": {},
      "auth": false,
      "budgets_ms": {"warm": 100, "cold": null},
      "cache_state": "stateless liveness probe"
    },
    "login": {
      "method": "POST",
      "path": "/api/auth/login",
      "query": {},
      "auth": false,
      "budgets_ms": {"warm": 500, "cold": null},
      "cache_state": "bcrypt verify + one session row per call"
    },
    "agri_filters": {
      "method": "GET",
      "path": "/api/agri/filters",
      "query": {},
      "auth": false,
      "budgets_ms": {"warm": 500, "cold": 10000},
      "cache_state": "agri cache: first request in a process populates/reloads it"
    },
    "agri_prices": {
      "method": "GET",
      "path": "/api/agri/prices",
      "query": {"commodity": "onion", "range": "1m"},
      "auth": false,
      "budgets_ms": {"warm": 500, "cold": null},
      "cache_state": "agri cache + commodity series cache"
    },
    "nifty_report": {
      "method": "GET",
      "path": "/api/reports/nifty",
      "query": {},
      "auth": false,
      "budgets_ms": {"warm": 1000, "cold": null},
      "cache_state": "requires a stored session snapshot; 404 on non-trading days is SKIP, not FAIL"
    },
    "profitability": {
      "method": "GET",
      "path": "/api/reports/profitability",
      "query": {},
      "auth": false,
      "budgets_ms": {"warm": 2000, "cold": null},
      "cache_state": "report cache (cached=false on first call)"
    },
    "market_snapshot": {
      "method": "GET",
      "path": "/api/market/snapshot",
      "query": {"universe": "all_equity", "limit": "100"},
      "auth": true,
      "budgets_ms": {"warm": 2000, "cold": null},
      "cache_state": "screener snapshot cache; no force=1"
    },
    "replay_configs": {
      "method": "GET",
      "path": "/api/replay/configs",
      "query": {},
      "auth": true,
      "budgets_ms": {"warm": 500, "cold": null},
      "cache_state": "DB read, no shared cache"
    }
  }
}
